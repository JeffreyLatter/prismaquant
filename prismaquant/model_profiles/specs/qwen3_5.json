{
  "schema": "prismaquant.model_structure.v1",
  "id": "qwen3_5",
  "default_serving_profile": "vllm_qwen3_5_packed_moe",
  "match": {
    "model_type": ["qwen3_5_moe", "qwen3_5_moe_text", "qwen3_5"],
    "architectures": ["Qwen3_5*", "Qwen3.5*", "Qwen3_6*", "Qwen3.6*"]
  },
  "naming": {
    "live_to_recipe": [
      {
        "strip_prefix": "model.language_model.",
        "add_prefix": "model."
      }
    ],
    "recipe_to_source": [
      {
        "prefix": "mtp.",
        "replace": "mtp.",
        "stop": true
      },
      {
        "prefix": "model.visual.",
        "replace": "model.visual.",
        "stop": true
      },
      {
        "prefix": "model.language_model.",
        "replace": "model.language_model.",
        "stop": true
      },
      {
        "prefix": "model.",
        "replace": "model.language_model."
      }
    ],
    "recipe_to_vllm": [
      {
        "prefix": "mtp.",
        "replace": "mtp.",
        "stop": true
      },
      {
        "exact": "lm_head",
        "replace": "language_model.lm_head",
        "stop": true
      },
      {
        "prefix": "model.visual.",
        "replace": "visual.",
        "stop": true
      },
      {
        "prefix": "model.language_model.",
        "replace": "language_model.model."
      },
      {
        "prefix": "model.",
        "replace": "language_model.model."
      }
    ]
  },
  "fused_groups": [
    {
      "target": "self_attn.qkv_proj",
      "members": ["self_attn.q_proj", "self_attn.k_proj", "self_attn.v_proj"]
    },
    {
      "target": "mlp.gate_up_proj",
      "members": ["mlp.gate_proj", "mlp.up_proj"]
    },
    {
      "target": "linear_attn.in_proj_qkvz",
      "members": ["linear_attn.in_proj_qkv", "linear_attn.in_proj_z"]
    },
    {
      "target": "linear_attn.in_proj_ba",
      "members": ["linear_attn.in_proj_b", "linear_attn.in_proj_a"]
    }
  ],
  "packed_experts": {
    "param_names": ["gate_up_proj", "down_proj"],
    "split_for_formats": ["*"],
    "format_groups": [
      ["gate_up_proj", "down_proj"],
      ["gate_proj", "up_proj", "down_proj"],
      ["w1", "w2", "w3"]
    ]
  },
  "moe": {
    "per_expert_regex": "re:^language_model[.]model[.]layers[.][0-9]+[.]mlp[.]experts[.][0-9]+[.](gate|up|down)_proj$",
    "per_expert_mtp_regex": "re:^mtp[.]layers[.][0-9]+[.]mlp[.]experts[.][0-9]+[.](gate|up|down)_proj$"
  },
  "passthrough_prefixes": ["model.visual.", "mtp."],
  "pinned_names": ["lm_head"]
}
