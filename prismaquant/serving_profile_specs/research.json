{
  "schema": "prismaquant.serving_profile.v1",
  "id": "research",
  "runtime": "generic_gpu_kernel",
  "description": "Research/default profile: no serving format menu restrictions, but keep known runtime kernel shape constraints out of allocator candidates.",
  "runtime_shape_validators": [
    {
      "id": "flashinfer_mxfp8_problem_size",
      "formats": ["MXFP8_E4M3", "MXFP8_E5M2"],
      "callable": "prismaquant.runtime_shape_validators:flashinfer_mxfp8_problem_size_accepts",
      "optional": true,
      "reason": "kernel_shape"
    }
  ],
  "shape_rules": [
    {
      "id": "mxfp8_cutlass_shape",
      "formats": ["MXFP8_E4M3", "MXFP8_E5M2"],
      "min_in_features": 128,
      "min_out_features": 128,
      "in_features_multiple_of": 32,
      "out_features_multiple_of": 128,
      "reason": "kernel_shape"
    },
    {
      "id": "nvfp4_cutlass_shape",
      "formats": ["NVFP4"],
      "in_features_multiple_of": 16,
      "reason": "kernel_shape"
    }
  ]
}
