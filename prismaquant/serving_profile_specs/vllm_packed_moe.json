{
  "schema": "prismaquant.serving_profile.v1",
  "id": "vllm_packed_moe",
  "runtime": "vllm",
  "extends": ["research"],
  "description": "Generic vLLM serving constraints for packed-MoE compressed-tensors artifacts.",
  "runtime_packages": [
    {
      "id": "flashinfer",
      "module": "flashinfer",
      "version": "0.6.8.post1",
      "pip_packages": ["flashinfer-python", "flashinfer-cubin"],
      "env": {
        "FLASHINFER_DISABLE_VERSION_CHECK": "1"
      },
      "optional": true
    }
  ],
  "format_rules": [
    {
      "id": "packed_moe_expert_formats",
      "when": {
        "regex": "(^|[.])(?:mlp[.]|moe[.])?experts([.]|$)"
      },
      "allow_formats": ["NVFP4", "MXFP4", "MXFP8", "MXFP8_E4M3", "BF16"],
      "reason": "profile_mismatch",
      "detail": "The selected vLLM packed-MoE serving path only supports NVFP4, MXFP4, MXFP8_E4M3, or BF16 for expert tensors; plain FP8 and E5M2 stay research-only until a vLLM packed-MoE load smoke passes"
    },
    {
      "id": "dense_formats_without_vllm_fast_path",
      "when": {
        "not_regex": "(^|[.])(?:mlp[.]|moe[.])?experts([.]|$)"
      },
      "deny_formats": ["MXFP4", "MXFP8_E5M2", "FP8_E5M2"],
      "reason": "profile_mismatch",
      "detail": "This format is not enabled for dense Linears in the selected vLLM serving profile"
    }
  ]
}
